{
  "name": "@dm-bishnoi/local-ci-runner",
  "version": "0.1.1",
  "description": "Run Angular CI checks locally before pushing, with preflight diagnostics and console, JSON, and HTML reports.",
  "type": "module",
  "bin": {
    "local-ci-runner": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "local-ci",
    "local-ci-runner",
    "ci",
    "continuous-integration",
    "pipeline",
    "ci-pipeline",
    "build-validation",
    "preflight",
    "developer-tools",
    "cli",
    "angular",
    "test-automation",
    "process-management",
    "reporting"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "execa": "^9.6.0",
    "ora": "^8.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "author": "Dharmender Bishnoi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dm-bishnoi/local-ci.git"
  },
  "homepage": "https://github.com/dm-bishnoi/local-ci#readme",
  "bugs": {
    "url": "https://github.com/dm-bishnoi/local-ci/issues"
  }
}
